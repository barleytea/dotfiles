{
  "env": {
    "EDITOR": "nvim",
    "GH_CONFIG_DIR": "~/.config/github-cli",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git stash:*)",
      "Bash(git checkout -b:*)",
      "Bash(git pull:*)",
      "Bash(find:*)",
      "Bash(fd:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(touch:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(awk:*)",
      "Bash(make:*)",
      "Bash(go *)",
      "Bash(nix build:*)",
      "Bash(nix flake check:*)",
      "Bash(nixos-rebuild build:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx eslint:*)",
      "Bash(npx tsc:*)",
      "Bash(npx tsx:*)",
      "Bash(npx vitest:*)",
      "Bash(npx cdk synth:*)",
      "mcp__pencil"
    ],
    "ask": [
      "Agent(model:opus)",
      "Agent(model:fable)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Read(~/.npmrc_local)",
      "Read(~/.zshrc_local)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(/etc/nixos/secrets/**)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "autoMode": {
    "environment": [
      "Personal dotfiles repository, public on GitHub (barleytea/dotfiles).",
      "Repositories live in ghq layout: ~/git_repos/github.com/<owner>/<repo>.",
      "Hosts are Nix-managed (nix-darwin + home-manager on macOS, NixOS on the Linux desktop) plus one plain WSL2 host used for CTF work.",
      "No production infrastructure, no customer data, and no cloud accounts with billing exposure are reachable from these machines.",
      "Git remotes are the user's own GitHub account only.",
      "Secrets live outside the repository in ~/.npmrc_local, ~/.zshrc_local, /etc/nixos/secrets, ~/.ssh and ~/.aws; they must never be read, printed, or committed."
    ],
    "hard_deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Read(~/.npmrc_local)",
      "Read(~/.zshrc_local)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(/etc/nixos/secrets/**)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(nixos-rebuild switch:*)",
      "Bash(darwin-rebuild switch:*)",
      "Bash(home-manager switch:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh secret set:*)",
      "Bash(npm publish:*)",
      "Bash(gh release create:*)"
    ]
  },
  "model": "fable[1m]",
  "effortLevel": "high",
  "modelSettings": {
    "sonnet": {
      "effortLevel": "medium"
    },
    "haiku": {
      "effortLevel": "low"
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-skill.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/save-session.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -f ~/.claude/hooks/herdr-agent-state.sh ] && bash ~/.claude/hooks/herdr-agent-state.sh session || true'",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 1
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  },
  "language": "Japanese",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "cache.nixos.org",
        "nixos.org",
        "search.nixos.org",
        "registry.npmjs.org",
        "nodejs.org",
        "*.googleapis.com",
        "*.pkg.dev",
        "*.amazonaws.com",
        "*.aws.amazon.com",
        "proxy.golang.org",
        "sum.golang.org",
        "localhost",
        "127.0.0.1",
        "::1"
      ]
    },
    "filesystem": {
      "denyRead": [
        "~/.npmrc_local",
        "~/.zshrc_local",
        "~/.ssh",
        "~/.aws",
        "/etc/nixos/secrets"
      ]
    },
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "docker",
      "gh",
      "security",
      "nix",
      "nixos-rebuild",
      "darwin-rebuild",
      "home-manager"
    ],
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.npmrc_local",
          "mode": "deny"
        },
        {
          "path": "~/.zshrc_local",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GH_TOKEN",
          "mode": "mask"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "mask"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "mask"
        }
      ]
    }
  }
}

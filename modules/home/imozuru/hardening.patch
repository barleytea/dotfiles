+def check_url(url: str) -> None:
+    """取りに行ってよい URL か確かめる。だめなら ValueError を投げる。
+
+    取ってきたページの文に誘導されても、手元のファイル（file://）や、手元・社内のサービス
+    （127.0.0.1、169.254.169.254 のメタデータなど）を読みに行かないようにする。転送先にも同じ検査をかける。
+    """
+    parts = urllib.parse.urlsplit(url)
+    host = parts.hostname
+    if parts.scheme not in ("http", "https") or not host:
+        raise ValueError(f"http(s) の URL ではない: {url[:100]}")
+    try:
+        addresses = [ipaddress.ip_address(host)]
+    except ValueError:
+        if host == "localhost" or host.endswith(".localhost"):
+            raise ValueError(f"手元のアドレスには取りに行かない: {host}") from None
+        if urllib.request.getproxies().get(parts.scheme) and not urllib.request.proxy_bypass(host):
+            # プロキシ経由（サンドボックスなど）では名前を引くのはプロキシで、行き先はプロキシの許可で絞られる
+            return
+        try:
